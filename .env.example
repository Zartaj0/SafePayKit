# ── LLM providers ────────────────────────────────────────────────────────────
# SafePayKit tries each configured provider in order and uses the first that
# responds. Set one or more; the rest are skipped automatically.
#
# Gemini (Google) — free tier available
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# 0G decentralized AI — uses your wallet private key for auth
ZERO_G_PRIVATE_KEY=
ZERO_G_URL=https://api.0g.ai/v1/chat/completions
ZERO_G_MODEL=llama-3.3-70b-instruct

# OpenRouter — free models available (default: google/gemma-3-27b-it:free)
OPENROUTER=
OPENROUTER_MODEL=google/gemma-3-27b-it:free

# NVIDIA NIM
NVIDIA=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# Mistral
MISTRAL=
MISTRAL_MODEL=mistral-small-latest

# OpenCode
OPENCODE=
OPENCODE_URL=https://api.opencode.ai/v1/chat/completions
OPENCODE_MODEL=gpt-4o-mini

# ── Solana devnet ─────────────────────────────────────────────────────────────
# Only needed for live Solana devnet settlement proof (npm run demo:real).
# Never commit a real private key.
DEVNET_PRIVATE_KEY=
SOLANA_RPC_URL=https://api.devnet.solana.com
